<ul class="card-text font-weight-light list-group list-group-flush">
  {%- assign education_section = data | where: "title", "Education" | first -%}
  {%- assign education = education_section.contents -%}

  {%- for content in education -%}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 col-sm-2 col-md-2 text-center date-column">
          <table class="table-cv ml-1 ml-md-2 institution">
            <tbody>
              <tr>
                <td>
                  {%- if content.year -%}
                    <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px">
                      {{ content.year }}
                    </span>
                  {%- endif -%}
                </td>
              </tr>
              {%- if content.location -%}
              <tr>
                <td>
                  <p class="location">
                    <i class="fa-solid fa-location-dot iconlocation"></i>
                    {{ content.location }}
                  </p>
                </td>
              </tr>
              {%- endif -%}
            </tbody>
          </table>
        </div>

        <div class="col-xs-10 col-sm-10 col-md-10 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-2">
            {%- if content.url -%}<a href="{{ content.url }}">{%- endif -%}
            {{ content.title }}
            {%- if content.url -%}</a>{%- endif -%}
          </h6>

          {%- if content.institution -%}
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ content.institution }}</h6>
          {%- endif -%}

          {%- if content.area -%}
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">{{ content.area }}</h6>
          {%- endif -%}

          {%- if content.GPA -%}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">Cumulative GPA: {{ content.GPA }}</h6>
          {%- endif -%}

          {%- if content.courses and content.courses.size > 0 -%}
          <ul class="items ml-1 ml-md-4">
            {%- for item in content.courses -%}
              <li><span class="item">{{ item }}</span></li>
            {%- endfor -%}
          </ul>
          {%- endif -%}
          {%- if content.description and content.description.size > 0 -%}
          <ul class="items ml-1 ml-md-4">
            {%- for d in content.description -%}
              {%- if d.title and d.contents -%}
                <li>
                  <span class="item"><strong>{{ d.title }}</strong></span>
                  <ul>
                    {%- for sub in d.contents -%}
                      <li><span class="item">{{ sub }}</span></li>
                    {%- endfor -%}
                  </ul>
                </li>
              {%- else -%}
                <li><span class="item">{{ d }}</span></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          {%- endif -%}
        </div>
      </div>
    </li>
  {%- endfor -%}
</ul>