<div class="career-project-grid">
  {% for project in site.data.featured_projects %}
    <article class="career-project">
      <h3>{{ project.title }}</h3>
      <p class="project-focus">{{ project.focus }}</p>
      <p>{{ project.summary }}</p>
      {% unless include.compact %}
        <p><strong>My contribution:</strong> {{ project.contribution }}</p>
        <p><strong>Tools and methods:</strong> {{ project.tools }}</p>
      {% endunless %}
      <ul class="project-links" aria-label="{{ project.title }} resources">
        {% for link in project.links %}
          <li>
            <a href="{{ link.url }}">
              {{- link.label -}}
              <span class="sr-only"> for {{ project.title }}</span></a
            >
          </li>
        {% endfor %}
      </ul>
    </article>
  {% endfor %}
</div>
