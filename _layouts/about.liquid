---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    <div class="career-intro">
      <div class="career-summary">{{ content }}</div>
      {% if page.profile.image %}
        <div class="profile">
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% assign profile_image_alt = site.first_name | append: ' ' | append: site.last_name %}
          {% include figure.liquid loading="eager" path=profile_image_path class="img-fluid rounded" sizes="(min-width: 768px) 270px, 220px" alt=profile_image_alt cache_bust=true %}
        </div>
      {% endif %}
    </div>

    {% if page.featured_projects %}
      <section class="career-section" aria-labelledby="featured-projects">
        <h2 id="featured-projects"><a href="{{ '/repositories/' | relative_url }}">Featured projects</a></h2>
        {% include featured_projects.liquid compact=true %}
        <p><a href="{{ '/repositories/' | relative_url }}">Explore project contributions and tools</a></p>
      </section>
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">News</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    {% if page.background %}
      <section class="career-section" aria-labelledby="background">
        <h2 id="background">Background</h2>
        {{ page.background | markdownify }}
        <p><a href="{{ '/cv/' | relative_url }}">View experience and education</a></p>
      </section>
    {% endif %}
    {% if page.interests %}
      <p>{{ page.interests }}</p>
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
